# Copy to .env.local for local service testing, or set in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Use the managed Postgres connection URI with TLS enabled.
DATABASE_URL=
# Optional metadata enrichment
YOUTUBE_API_KEY=
# Sign-in providers to offer (comma-separated: github, google, email). Enable each one in Supabase first.
# "email" sends a one-time link; for more than a few sign-ins an hour, set up custom SMTP in Supabase.
AUTH_PROVIDERS=github,email
# 1 = show Circle, People, follows, Taste Passport, onboarding and public vouching. Off until there are curators.
NEXT_PUBLIC_VOUCH_SOCIAL=
# 1 = run the note experiment: half of browsers see picks without the Hacker News comment.
VOUCH_NOTE_EXPERIMENT=
